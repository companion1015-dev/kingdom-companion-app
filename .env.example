# LiveKit Cloud project credentials (or your self-hosted LiveKit server)
# Get these from https://cloud.livekit.io -> your project -> Settings -> Keys
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Your LiveKit server URL. For LiveKit Cloud it looks like:
#   wss://your-project.livekit.cloud
# For self-hosted (see server/docker-compose.yml), use:
#   ws://localhost:7880
LIVEKIT_URL=wss://your-project.livekit.cloud

# Port for this token/room API
PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
